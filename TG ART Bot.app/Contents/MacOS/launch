#!/bin/zsh

# Приложение можно перенести в /Applications: путь к проекту на этом Mac фиксирован.
PROJECT_DIR="/Users/mohonovproduction/Documents/TG_ART_bot"
RUN_SCRIPT="$PROJECT_DIR/run-bot.command"

if [[ ! -x "$RUN_SCRIPT" ]]; then
  /usr/bin/osascript -e 'display alert "TG ART Bot" message "Не найден run-bot.command в папке проекта." as critical'
  exit 1
fi

# Opening a .command file is handled by Launch Services and does not require the
# Apple Events permission for controlling Terminal. macOS may revoke that
# permission after a system update, which made the previous AppleScript-based
# launcher appear to do nothing.
/usr/bin/open -a Terminal "$RUN_SCRIPT"
