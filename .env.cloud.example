# Новый токен отдельного бота. Старый токен остаётся в .env для запуска на Mac.
BOT_TOKEN=put_your_bot_token_here
ALLOWED_USER_ID=123456789
DEFAULT_FPS=30
DEFAULT_DURATION=3
MAX_EMOJI_SIZE_KB=64
MAX_STATIC_STICKER_SIZE_KB=512
MAX_VIDEO_STICKER_SIZE_KB=256
PACK_TITLE_SUFFIX=by @mohonovproduction
MAX_CONCURRENT_JOBS=2
